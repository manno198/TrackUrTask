# Postgres connection string (local dev: see docker-compose.yml)
DATABASE_URL=postgres://trackurtask:trackurtask@localhost:5434/trackurtask

# Postgres connection string used only when running `npm test`
DATABASE_URL_TEST=postgres://trackurtask:trackurtask@localhost:5434/trackurtask_test

# Set to "true" when connecting to RDS (enables TLS)
DB_SSL=false

PORT=5000

# JWT signing secret - required, no default. Generate a long random value for real deployments.
JWT_SECRET=change_this_to_a_long_random_value

# The deployed frontend origin — the primary allowed CORS origin in production.
FRONTEND_URL=http://your-frontend-bucket.s3-website.your-region.amazonaws.com

# Extra CORS origins (comma-separated) — for local dev, or additional origins
# beyond FRONTEND_URL. Never falls back to "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Credentials used by `npm run seed` to create the initial admin user
SEED_ADMIN_EMAIL=admin@company.com
SEED_ADMIN_PASSWORD=admin123
